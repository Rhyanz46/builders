# Copy to .env.local and fill in from your Supabase project:
# Project Settings → API.
#
# Both are meant to be public — the anon key is what the browser would use, and
# the row level security policies in supabase/migrations/ are what actually
# guard the data. Never put the service_role key here; it bypasses every policy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where confirmation emails should send people back to. Leave unset locally and
# the current request's origin is used.
# NEXT_PUBLIC_SITE_URL=https://builders.swegrowth.id

# Google login needs no additional secret in this app. Enable Google under
# Supabase Authentication -> Providers and store the Google client ID/secret
# there. See README.md for the callback and redirect URLs that must be allow-listed.

# Optional: any read-only GitHub token. Lifts the anonymous API rate limit for
# the stars and last-push numbers in the directory.
GITHUB_TOKEN=

# Local preview only: show the site as this member under `next dev`, since
# signing in through GitHub returns to the deployed site. Reads only; every
# write is still refused. Ignored in production.
# DEV_VIEW_AS=your-username

# Which of the two sites this deploy is (see app/lib/site.ts): `builders`
# (default: members' products) or `oss` (open source: repositories and pull
# requests). Set per Netlify site, with that site's own NEXT_PUBLIC_SITE_URL.
# NEXT_PUBLIC_SITE=oss
# NEXT_PUBLIC_SITE_URL=https://oss.swegrowth.id

# Share one sign-in across builders.swegrowth.id and oss.swegrowth.id by
# keeping the auth cookies on the parent domain. Leave unset locally.
# NEXT_PUBLIC_COOKIE_DOMAIN=.swegrowth.id
